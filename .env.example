# Codize environment contract — copy to .env and fill in real values.
# NEVER commit .env. NEVER reference the server-only variables from frontend code:
# anything in frontend source gets bundled into public JS (OWASP A02).

# --- Safe for the frontend (public by design) ---
# Project API URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Publishable/anon key. Public, but all data access still goes through the
# backend — the frontend uses this only for Supabase Auth (signup/login).
# Accepts either the newer publishable key (sb_publishable_...) or the legacy
# JWT-shaped anon key — the backend treats it as opaque (live-verified M9).
SUPABASE_ANON_KEY=

# --- SERVER-ONLY. Backend (FastAPI) environment only. Never in frontend files. ---
# Service-role/secret key: bypasses RLS entirely. Backend-to-Supabase calls only.
# Accepts either the newer secret key (sb_secret_...) or the legacy JWT-shaped
# service_role key — treated as opaque (live-verified M9).
SUPABASE_SERVICE_ROLE_KEY=
# LLM provider keys (M7+). Provider order: Gemini primary, OpenRouter fallback,
# deterministic stub when neither key is set. Backend only.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Direct Postgres connection string. Only needed if the backend ever talks to
# the DB without PostgREST; not required for the current milestones.
# DATABASE_URL=

# --- Backend (FastAPI) runtime config — not secrets ---
# Environment label returned by GET /health: development | production
APP_ENV=development
# Primary LLM provider: gemini | openrouter | stub (stub = tests/no-key mode)
LLM_PROVIDER=gemini
# Model names (defaults shown; not secrets)
GEMINI_MODEL=gemini-2.5-flash-lite
OPENROUTER_MODEL=cohere/north-mini-code:free
# Comma-separated explicit CORS origins. Never "*". Local Next.js dev default:
CORS_ORIGINS=http://localhost:3000
# Note: the JWT verification (JWKS) URL is derived from SUPABASE_URL —
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json — no separate variable needed.
