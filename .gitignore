# Secrets — never committed
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
venv/
.venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Node / frontend (Milestone 13+)
node_modules/
.next/
dist/
build/

# V2 Build is an application route, not generated build output. Keep the
# source route trackable while the generic rule continues to ignore real
# build-output directories everywhere else.
!frontend/app/app/project/\[id\]/build/
!frontend/app/app/project/\[id\]/build/page.tsx
!frontend/app/app/project/\[id\]/build/page.contract.test.ts

# Logs / local runtime artifacts
*.log
logs/

# Deployment platform (local CLI state)
.vercel/

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Claude Code local settings
.claude/settings.local.json

# Playwright MCP session artifacts (screenshots, console/network logs)
.playwright-mcp/
