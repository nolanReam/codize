# Codize frontend environment. Every NEXT_PUBLIC_* value is bundled into the
# client JS and is therefore PUBLIC BY DESIGN — only client-safe values here.
#
# NEVER add SUPABASE_SERVICE_ROLE_KEY / sb_secret_* keys, GEMINI_API_KEY,
# OPENROUTER_API_KEY, or any other server-only secret to this file or to the
# frontend environment. Those live only in the backend's environment.

# Supabase project URL (used for Auth only — data goes through the backend).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable/anon key (sb_publishable_... or legacy anon key).
# Designed to be public; RLS and the backend enforce access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# FastAPI backend base URL (no trailing slash).
# Local dev: http://localhost:8000
# Hosted (Vercel env var, NOT this file): the deployed backend URL, e.g.
#   https://codize-api.up.railway.app
# Next.js reads this at BUILD time — changing it requires a rebuild/redeploy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
